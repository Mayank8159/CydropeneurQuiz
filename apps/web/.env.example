# Set this to the AWS API Gateway URL for the backend (defined in .env)
NEXT_PUBLIC_API_URL=

# Required Passkeys & Admin Credentials (must be provided in .env, not committed to git)
NEXT_PUBLIC_EVENT_PASSKEY=
NEXT_PUBLIC_ADMIN_PASSKEY=
ADMIN_EMAIL=
ADMIN_PASSKEY=

# Dev-only admin fallback — active only when NODE_ENV=development AND ADMIN_EMAIL is not set.
# Set these in .env.local (gitignored) for local testing without a real ADMIN_EMAIL configured.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=
NEXT_PUBLIC_DEV_ADMIN_PASSKEY=
